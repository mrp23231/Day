# Production and local development: copy to .env.local; never commit real values.
# Public Supabase project settings are embedded into the client at build time.
# Set these BEFORE npm run build; changing them requires a new build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never add NEXT_PUBLIC_ to these variable names.
# Required for authenticated account deletion; keep out of browser bundles/logs.
SUPABASE_SERVICE_ROLE_KEY=

# Food photo recognition: default Gemini provider. Requires Supabase authentication.
# A free-tier-capable model is selected; actual quota/billing depends on the Google project.
# Keep GEMINI_API_KEY server-only. Never prefix it with NEXT_PUBLIC_.
FOOD_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FOOD_MODEL=gemini-3.1-flash-lite

# Day AI chat uses OpenAI. Food uses it only with explicit FOOD_AI_PROVIDER=openai.
# There is no automatic fallback from Gemini to a paid provider.
OPENAI_API_KEY=
# Optional. Availability and billing must be verified in the target OpenAI project.
OPENAI_MODEL=gpt-4.1-mini
